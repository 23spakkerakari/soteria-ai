        "mechanism": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mechanism"
        },
        "acuity": {
          "enum": [
            "life_threat",
            "urgent",
            "semi_urgent",
            "field_manageable"
