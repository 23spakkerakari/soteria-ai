        "must_recognize": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Must Recognize",
          "type": "array"
        },
        "must_ask": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Must Ask",
          "type": "array"
        },
        "must_escalate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Must Escalate"
        },
        "must_not_recommend": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Must Not Recommend",
          "type": "array"
        },
        "derived_from": {
          "default": "source_answer_key",
          "enum": [
            "source_answer_key",
            "source_learning_objectives",
            "editor"
          ],
